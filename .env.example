# Copy to ".env" and fill in. The server reads this file automatically.

# Port the Node app listens on (Caddy will proxy 443 -> this).
PORT=4300

# Shared secret protecting the API. Leave BLANK for open local dev.
# Generate a strong one, e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# This is the same value you paste as the API key in the custom GPT.
DASHBOARD_TOKEN=
